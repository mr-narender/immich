#!/bin/sh
# postinst — runs as root after package files are extracted.
INSTALL_ROOT="/var/packages/immich/target"
CONF_DIR="${INSTALL_ROOT}/conf"
CONF_FILE="${CONF_DIR}/immich.conf"
PKG_USER="immich"
PKG_VAR="/var/packages/immich/var"

mkdir -p "${CONF_DIR}" "${PKG_VAR}"

# First-install: write conf from env.default, applying wizard choices.
if [ ! -f "${CONF_FILE}" ]; then
    cp "${INSTALL_ROOT}/env.default" "${CONF_FILE}"
    [ -n "${WIZARD_UPLOAD_LOCATION:-}" ] && \
        sed -i "s|^UPLOAD_LOCATION=.*|UPLOAD_LOCATION=${WIZARD_UPLOAD_LOCATION}|" "${CONF_FILE}"
    [ -n "${WIZARD_DB_PASSWORD:-}" ] && \
        sed -i "s|^DB_PASSWORD=.*|DB_PASSWORD=${WIZARD_DB_PASSWORD}|" "${CONF_FILE}"
fi

# Register package feed so DSM notifies on new Immich releases.
# User opted in via wizard (WIZARD_ADD_FEED=yes) or this is a silent upgrade.
FEED_URL="https://raw.githubusercontent.com/mr-narender/immich/main/packages.json"
FEED_NAME="Immich (mr-narender)"
FEED_CFG="/usr/syno/etc/packages/feeds.conf"
if [ "${WIZARD_ADD_FEED:-yes}" != "no" ]; then
    if [ -f "${FEED_CFG}" ]; then
        if ! grep -qF "${FEED_URL}" "${FEED_CFG}" 2>/dev/null; then
            echo "${FEED_NAME}|${FEED_URL}" >> "${FEED_CFG}"
        fi
    fi
fi

# Deploy custom libvips (libheif 1.20.1 + libde265) to replace the bundled
# @img/sharp-libvips-linux-x64 copy, which lacks HEVC/HEIC decoder support.
HEIF_LIBS="${INSTALL_ROOT}/lib/heif"
SHARP_LIBVIPS_DIR="${INSTALL_ROOT}/server/node_modules/.pnpm/@img+sharp-libvips-linux-x64@1.3.2/node_modules/@img/sharp-libvips-linux-x64/lib"
VIPS_MODULE_DIR="${INSTALL_ROOT}/lib/vips-modules-8.18"

if [ -f "${HEIF_LIBS}/libvips-cpp.so.8.18.3" ] && [ -d "${SHARP_LIBVIPS_DIR}" ]; then
    cp "${HEIF_LIBS}/libvips-cpp.so.8.18.3" "${SHARP_LIBVIPS_DIR}/libvips-cpp.so.8.18.3"
fi

# Deploy main libvips.so.42 so our libvips-cpp.so.8.18.3 and vips-heif.so can find it.
# Our custom .so files have RPATH=/var/packages/immich/target/lib (compiled with that prefix).
if [ -f "${HEIF_LIBS}/libvips.so.42.20.3" ]; then
    mkdir -p "${INSTALL_ROOT}/lib"
    cp "${HEIF_LIBS}/libvips.so.42.20.3" "${INSTALL_ROOT}/lib/libvips.so.42.20.3"
    ln -sf libvips.so.42.20.3 "${INSTALL_ROOT}/lib/libvips.so.42"
    ln -sf libvips.so.42      "${INSTALL_ROOT}/lib/libvips.so"
fi

if [ -f "${HEIF_LIBS}/vips-heif.so" ]; then
    mkdir -p "${VIPS_MODULE_DIR}"
    cp "${HEIF_LIBS}/vips-heif.so" "${VIPS_MODULE_DIR}/vips-heif.so"
fi

# Ownership + permissions
. "${CONF_FILE}" 2>/dev/null || true
mkdir -p \
    "${UPLOAD_LOCATION:-/var/packages/immich/var/upload}" \
    "${INSTALL_ROOT}/log" "${INSTALL_ROOT}/run"
chown -R "${PKG_USER}:${PKG_USER}" \
    "${CONF_DIR}" "${PKG_VAR}" \
    "${INSTALL_ROOT}/log" "${INSTALL_ROOT}/run" 2>/dev/null || true
chmod 750 "${CONF_DIR}"
chmod 640 "${CONF_FILE}" 2>/dev/null || true

exit 0
